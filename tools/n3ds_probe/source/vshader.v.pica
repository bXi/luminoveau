; n3ds_probe triangle vertex shader (picasso).
; v0 = position (xyz), v1 = color (rgb). Output = projected position + color.

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  zeros myconst.xxxx ; (0,0,0,0)
.alias  ones  myconst.yyyy ; (1,1,1,1)

; Outputs
.out outpos position
.out outclr color

; Inputs
.alias inpos v0
.alias inclr v1

.proc main
	; r0 = (inpos.xyz, 1.0)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; outpos = projection * r0
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; outclr = (inclr.rgb, 1.0)
	mov outclr.xyz, inclr
	mov outclr.w,   ones

	end
.end
