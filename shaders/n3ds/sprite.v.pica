; Luminoveau sprite vertex shader (picasso / PICA200).
;
; Vertices are fully CPU-expanded by the n3ds SpriteRenderPass (pivot/scale/rotate/
; translate already applied), so this shader only projects and forwards attributes.
;
; Attributes:
;   v0 = position.xyz  (float3, logical engine coordinates)
;   v1 = uv            (float2, logical [0..1] engine UVs, v=0 at the top)
;   v2 = color         (u8x4 rgba; PICA byte loaders are NOT normalized -> 0..255)
;
; Uniforms:
;   projection — engine camera pre-multiplied CPU-side with the GL->PICA fix-up
;                (tilt rotation on the screen target, depth remap everywhere);
;                built by Citro3dGpuBackend's fix-up helper.
;   uvscale    — per-texture UV transform (sx, -sy, 0, 1): maps logical UVs onto
;                the padded power-of-two texture, including the t-axis flip for
;                PICA's bottom-origin texel layout. tex = uv * uvscale.xy + uvscale.zw

; Uniforms
.fvec projection[4]
.fvec uvscale

; Constants
.constf consts(0.0, 1.0, 0.00392156862, 0.0) ; z = 1/255 (byte color -> [0,1])
.alias  ones consts.yyyy

; Outputs
.out outpos position
.out outtex texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias inuv  v1
.alias inclr v2

.proc main
	; r0 = (inpos.xyz, 1.0)
	mov r0.xyz, inpos
	mov r0.w,   ones

	; outpos = projection * r0
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; outtex = inuv * uvscale.xy + uvscale.zw
	mul r1.xy, uvscale.xyxy, inuv.xyxy
	add r1.xy, uvscale.zwzw, r1.xyxy
	mov outtex.xy, r1.xy

	; outclr = inclr / 255
	mul outclr, consts.zzzz, inclr

	end
.end
